## Required
# MySQL connection string — shared Appunik database
# Runtime user (no DROP/ALTER/CREATE privileges)
DATABASE_URL="mysql://hr_people_app:hr_people_app_pass@127.0.0.1:3306/appunik"
# Migration user (full DDL — only use for drizzle-kit push/migrate)
MIGRATE_DATABASE_URL="mysql://hr_people_migrate:hr_people_migrate_pass@127.0.0.1:3306/appunik"

## Optional (emails)
# If unset, the app still runs; automations will log but won't send emails.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="hr@yourdomain.com"
HR_ADMIN_EMAIL="hr-admin@yourdomain.com"

## Optional (Clerk auth)
# If unset, API server runs in dev-bypass auth mode.
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
