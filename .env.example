## Required
# MySQL connection string used by Drizzle + API server
DATABASE_URL="mysql://root:root@127.0.0.1:3306/hr_suite"

## Optional (emails)
# If unset, the app still runs; automations will log but won't send emails.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="hr@yourdomain.com"
HR_ADMIN_EMAIL="hr-admin@yourdomain.com"

## Optional (Clerk auth)
# If unset, API server runs in dev-bypass auth mode.
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
