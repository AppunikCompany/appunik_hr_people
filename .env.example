## Required
# MySQL connection string — shared Appunik database
# Runtime user (no DROP/ALTER/CREATE privileges)
DATABASE_URL="mysql://hr_people_app:hr_people_app_pass@127.0.0.1:3306/appunik"
# Migration user (full DDL — only use for drizzle-kit push/migrate)
MIGRATE_DATABASE_URL="mysql://hr_people_migrate:hr_people_migrate_pass@127.0.0.1:3306/appunik"

## Optional (emails — ZeptoMail SMTP)
# If SMTP_PASS is unset, the app still runs; automations will log but won't send emails.
# In ZeptoMail: Mail Agents → your agent → SMTP Details
SMTP_HOST="smtp.zeptomail.in"
SMTP_PORT="587"
SMTP_USER="emailapikey"
SMTP_PASS=""
FROM_EMAIL="no-reply@yourdomain.com"
FROM_NAME="Appunik HR"
HR_ADMIN_EMAIL="hr-admin@yourdomain.com"
APP_URL="https://your-hr-portal.com"

## Optional (Clerk auth)
# If unset, API server runs in dev-bypass auth mode.
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""

## Optional (Biometric attendance — EasyTime Pro / ZKTeco BioTime 8)
# If unset, biometric sync is disabled and attendance stays manual (web only).
# EASYTIME_URL is the base URL of the EasyTime Pro server (no trailing slash).
# The API user needs read access to Transactions + Personnel.
# Device emp_code must match the employee's employeeCode in this system.
EASYTIME_URL="http://122.174.67.53:8081"
EASYTIME_USER=""
EASYTIME_PASS=""
